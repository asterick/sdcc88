// (genIfx return paths) and miscompiling. Unconditional jp->ret (160) is kept.

// Replace jp by ret before replacing jp by jrs, since using ret can reduce the number of references to jump labels.
barrier

// The S1C88's only short jump is jrs (8-bit relative); an in-range jp shortens
// directly to it. (On z80 this rule produced `jr`, then a second pass mapped
// jr->jrs; the S1C88 has no `jr`, so emit jrs here and skip the intermediary.)
replace restart {
	jp	%5
} by {
	; common peephole 162 changed absolute to relative unconditional jump.
	jrs	%5
} if optimizeFor('!code-speed'), labelInRange(%5)

// NB: z80 peephole 162a (jp->jr for z180/ez80/rabbit/tlcs90) was REMOVED: its
// isPort() gate never matches 's1c88', so it was dead. 162 above covers us.
// labelInRange(%5) gates the jrs 8-bit range; out-of-range jp falls through to
// the jp->jrl map (s1c88-j3/j4) in the control-transfer section below.

replace restart {
	jp	%1, %5
} by {
	; common peephole 163 changed absolute to relative conditional jump.
	jrs	%1, %5
} if same(%1 'C' 'NC' 'NZ' 'Z'), labelInRange(%5)

replace restart {
	jrs	%1, %5
%5:
} by {
%5:
	; common peephole 164 eliminated relative conditional jump.
} if labelRefCountChange(%5 -1)




// ==========================================================================
// S1C88 instruction-legality fixups
// ==========================================================================

// `add hl,sp` does not exist on the S1C88 (16-bit add takes BA/HL/IX/IY/#imm,
// not SP), but `ld {hl,ix,iy},sp` and `add {hl,ix,iy},#imm` all do. gen.c and the
// !ldahlsp macro compute a frame/SP-relative address as `ld pair,#off; add
// pair,sp`; rewrite that to the legal `ld pair,sp; add pair,#off` (same result:
// off+SP == SP+off; both end on a 16-bit add, so flags are equivalent).
replace {
	ld	%1, #%2
	add	%1, sp
} by {
	ld	%1, sp
	add	%1, #%2
	; peephole s1c88-sp1 add pair,sp -> ld pair,sp; add pair,#off
} if same(%1 'hl' 'ix' 'iy')

// drop the degenerate `add pair,#0` left by sp1 for a zero frame offset.
replace {
	add	%1, #0
} by {
	; peephole s1c88-sp2 removed add pair,#0
} if same(%1 'hl' 'ix' 'iy'), notUsed('f')

// ==========================================================================
// S1C88 control-transfer mapping (was peeph-z80.def) -- KEEP LAST.
// These run after the jp->ret (160) and jp->jrs (162/163) passes above, so an
// in-range jump is already jrs (2 bytes) and only out-of-range/external ones
// reach here to fall through to jrl/carl (3 bytes). Do not move these earlier.
// ==========================================================================


// NB: z80 peephole 178 (xor a,a; ld d(ix),a -> ld d(ix),#0) was REMOVED for the
// S1C88: immediate-to-indexed-memory (and immediate-to-absolute) stores are
// illegal on the S1C88 (only `ld (hl),#nn` exists; `ld d(ix),#nn`/`ld (hhll),#nn`
// are "Invalid Addressing Mode"). The unfolded `xor a,a; ld d(ix),a` is legal.

// --- S1C88: all control transfers are PC-relative --------------------------
// The z80 model emits absolute jp/call; the generic peeph.def shortens an
// in-range jp to a short relative jump (162/163 above, which emit jrs directly
// for the S1C88). The S1C88 has no absolute jp/call — short relative is jrs/cars
// (8-bit), long relative is jrl/carl (16-bit). Map the residual (out-of-range or
// external) z80 branch mnemonics to their S1C88 long-relative equivalents.
//
// Conditional forms convert only for the basic flags c/nc/z/nz — jrl/jrs encode
// just those; the S1C88 signed/flag conditions (lt/ge/gt/le/v/nv/p/m/f0..) are
// CE-page short-only and stay as `jp <cc>`, which the assembler lowers via its
// invert-and-skip path (jrs <inv>,+4 ; jrl).  (No z80 parity po/pe — genCmp now
// emits the native S1C88 overflow conditions v/nv directly.)
// The notSame() guards keep the computed jp hl / jp (iy) / call (iy) forms from
// being mis-rewritten into a relative branch.

replace {
	jp	%5
} by {
	jrl	%5
	; peephole s1c88-j3 z80 jp -> s1c88 jrl (16-bit relative)
} if notSame(%5 'hl' 'ix' 'iy')

replace {
	jp	%1, %5
} by {
	jrl	%1, %5
	; peephole s1c88-j4 z80 jp cc -> s1c88 jrl cc
} if same(%1 'C' 'NC' 'NZ' 'Z')

replace {
	call	%5
} by {
	carl	%5
	; peephole s1c88-j5 z80 call -> s1c88 carl (16-bit relative call)
} if notSame(%5 'hl' 'ix' 'iy' '(__sdcc_fptr)')

replace {
	call	%1, %5
} by {
	carl	%1, %5
	; peephole s1c88-j6 z80 call cc -> s1c88 carl cc
} if same(%1 'C' 'NC' 'NZ' 'Z')

// genCmp emits the native signed-condition branches as `jp LT`/`jp GE` (and the
// peephole shortens them here). The S1C88 signed conditions exist ONLY as short
// relative (jrs/cars, 8-bit ±127) — there is no long signed branch — so only the
// in-range form is produced. An out-of-range signed branch would need an
// invert-and-skip (jrs <inv>,.+n; jrl target); rare, left for later, and it stays
// as the flagged `jp LT` until then.
replace {
	jp	LT, %5
} by {
	jrs	LT, %5
	; peephole s1c88-j7 signed less-than -> jrs LT
} if labelInRange(%5)

replace {
	jp	GE, %5
} by {
	jrs	GE, %5
	; peephole s1c88-j8 signed greater-or-equal -> jrs GE
} if labelInRange(%5)

replace {
	jp	GT, %5
} by {
	jrs	GT, %5
	; peephole s1c88-j9 signed greater-than -> jrs GT
} if labelInRange(%5)

replace {
	jp	LE, %5
} by {
	jrs	LE, %5
	; peephole s1c88-j10 signed less-or-equal -> jrs LE
} if labelInRange(%5)
