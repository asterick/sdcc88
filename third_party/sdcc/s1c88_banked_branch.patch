+/*)Function     VOID    outr1be(esp, r)
+ *
+ *              expr *  esp             pointer to expr structure
+ *              int     r               relocation mode (an escape mode, e.g.
+ *                                      R_S1C88_BANK)
+ *
+ * sdcc88: emit a SINGLE in-place relocation byte carrying an escape relocation
+ * mode, bypassing the s1c88 24-bit byte-select path that outrb()/outrxb() force
+ * (that path writes a 3-byte placeholder the linker collapses to 1, which
+ * desyncs an immediately-following relocation).  Used for the banked-branch NB
+ * bank byte so the slot is 6 bytes (ld nb,#bank ; <branch> disp16) — see
+ * sdas/as88/s1c88mch.c (S_PJUMP/S_PCALL) and lkrloc3.c (R_S1C88_BANK).
+ */
+VOID
+outr1be(struct expr *esp, int r)
+{
+        int n;
+
+        if (pass == 2) {
+                if (esp->e_flag == 0 && esp->e_base.e_ap == NULL) {
+                        /* absolute target: the NB bank byte is (value >> 16) */
+                        out_lxb(1, esp->e_addr >> 16, 0);
+                        if (oflag) {
+                                outchk(1, 0);
+                                out_txb(1, esp->e_addr >> 16);
+                        }
+                } else {
+                        r |= R_BYTE | esp->e_rlcf;
+                        out_lb(lobyte(esp->e_addr), r | R_RELOC);
+                        if (oflag) {
+                                outchk(1, 5);
+                                out_txb(1, esp->e_addr);  /* placeholder; linker writes the bank */
+                                if (esp->e_flag) {
+                                        n = esp->e_base.e_sp->s_ref;
+                                        r |= R_SYM;
+                                } else {
+                                        n = esp->e_base.e_ap->a_ref;
+                                }
+                                write_rmode(r, txtp - txt - 1);
+                                out_rw(n);
+                        }
+                }
+        }
+        dot.s_addr += 1;
+}
