diff --git a/sdas/linksrc/lkrloc3.c b/sdas/linksrc/lkrloc3.c
index 8c37943..77e6ed0 100644
--- a/sdas/linksrc/lkrloc3.c
+++ b/sdas/linksrc/lkrloc3.c
@@ -54,6 +54,399 @@
  *
  */
 
+/*
+ * sdcc88 #14c Stage 0 — link-time relaxation-opportunity report (READ-ONLY).
+ *
+ * Every R_S1C88_BANK slot that reaches the linker is a cross-area/cross-module
+ * banked branch: same-module slots are already relaxed assembler-side (#14b)
+ * and carry NO R_S1C88_BANK reloc, so they never get here.  This pass therefore
+ * tallies exactly the cross-module residual — how many of those slots COULD
+ * shrink if the linker grew a reflow pass (#14c stages 1-3) — without touching
+ * a single output byte.  Enable with env var SDLD_RELAX_REPORT=1; default off
+ * => zero behaviour change (the corpus stays byte-identical).  See
+ * docs/s1c88/banked-branch.md §10.
+ */
+static int  rlxEnabled = -1;            /* -1 = not yet probed                  */
+static long rlxNTotal;                  /* R_S1C88_BANK slots seen              */
+static long rlxNSameJrs;                /* same-bank, fits cars/jrs (reclaim 4) */
+static long rlxNSameJrl;                /* same-bank, fits carl/jrl (reclaim 3) */
+static long rlxNSameFar;                /* same-bank, out of carl range (0)     */
+static long rlxNCross;                  /* cross-bank, ld nb stays (blocked)    */
+static long rlxNCrossShort;             /* ...of which the branch fits cars (1) */
+static long rlxNFixed;                  /* slots in absolute areas (vectors)    */
+static long rlxBytes;                   /* estimated reclaimable bytes          */
+
+static int
+rlxOn(void)
+{
+        if (rlxEnabled < 0) {
+                char *e = getenv("SDLD_RELAX_REPORT");
+                rlxEnabled = (e != NULL && *e != '\0' && *e != '0') ? 1 : 0;
+        }
+        return rlxEnabled;
+}
+
+/*
+ * Account one R_S1C88_BANK slot.  tgt = resolved target address; abank =
+ * address of the [bank] byte in the slot `CE C4 [bank] <carl|jrl> <disp16>`.
+ * Pure tally — classification mirrors the relax forms in banked-branch.md §10
+ * using the canonical cars(+-127)/carl(+-32K) windows; the +-1 of the S1C88
+ * displacement convention is immaterial to a bytes-on-the-table estimate.
+ */
+static VOID
+rlxAccount(long tgt, long abank, int tbank, int cbank, int absarea)
+{
+        long dshort, dlong;
+
+        rlxNTotal++;
+        if (absarea) {
+                /* hardware-fixed vector slot — not reclaimable */
+                rlxNFixed++;
+                return;
+        }
+        if (tbank == 0 || tbank == cbank) {
+                /* same bank: drop the 3-byte `ld nb`, keep a relative branch
+                 * starting where CE was (abank-2). */
+                dshort = tgt - abank;            /* cars: opcode@abank-2, +2 */
+                dlong  = tgt - (abank + 1);      /* carl: opcode@abank-2, +3 */
+                if (dshort >= -128 && dshort <= 127) {
+                        rlxNSameJrs++;
+                        rlxBytes += 4;           /* 6B slot -> 2B cars */
+                } else if (dlong >= -32768 && dlong <= 32767) {
+                        rlxNSameJrl++;
+                        rlxBytes += 3;           /* 6B slot -> 3B carl */
+                } else {
+                        rlxNSameFar++;           /* unreachable as relative */
+                }
+        } else {
+                /* cross bank: the bank switch is mandatory (ld nb stays); only
+                 * the branch itself might shrink carl->cars (saves 1). */
+                rlxNCross++;
+                dshort = tgt - (abank + 3);      /* branch opcode@abank+1, +2 */
+                if (dshort >= -128 && dshort <= 127) {
+                        rlxNCrossShort++;
+                        rlxBytes += 1;
+                }
+        }
+}
+
+/*
+ * Print the accumulated report once, at end-of-link (called from lkmain.c).
+ */
+VOID
+s1c88RelaxReport(void)
+{
+        if (!rlxOn())
+                return;
+        fprintf(stderr, "[relax-report] cross-module banked-branch slots (R_S1C88_BANK):\n");
+        fprintf(stderr, "[relax-report]   total seen           : %ld\n", rlxNTotal);
+        fprintf(stderr, "[relax-report]   hardware-fixed (abs) : %ld  (vector table — NOT reclaimable)\n", rlxNFixed);
+        fprintf(stderr, "[relax-report]   same-bank, cars range: %ld  (reclaim 4B each)\n", rlxNSameJrs);
+        fprintf(stderr, "[relax-report]   same-bank, carl range: %ld  (reclaim 3B each)\n", rlxNSameJrl);
+        fprintf(stderr, "[relax-report]   same-bank, unreachable: %ld (reclaim 0)\n", rlxNSameFar);
+        fprintf(stderr, "[relax-report]   cross-bank (blocked) : %ld  (%ld branch-shrinkable, 1B each)\n",
+                rlxNCross, rlxNCrossShort);
+        fprintf(stderr, "[relax-report]   est. reclaimable     : %ld bytes  (#14c stages 1-3 upper bound)\n", rlxBytes);
+}
+
+/*
+ * sdcc88 #14c Stage (i) — measure + plan engine (READ-ONLY this increment).
+ *
+ * Builds the conservative single-pass shrink plan (which cross-module banked
+ * slots would drop their 3-byte `ld nb`), then derives the resulting address
+ * shift delta(addr) and the predicted post-relax area layout, with internal
+ * self-checks on the model.  It does NOT yet mutate addresses or emit bytes —
+ * that is the next increment, which needs the 3-pass driver in lkmain.c.
+ * Enabling SDLD_RELAX=1 only PRINTS the plan, so output stays byte-identical
+ * and every gate stays green.  Design: docs/s1c88/banked-branch.md §14c
+ * "Stage (i)".
+ */
+#define RLX_CARL_MARGIN 256             /* keep pre/post-shrink range decision in agreement */
+
+static int     rlx14c = -1;             /* SDLD_RELAX enabled? (lazy)             */
+static int     rlxEmit = -1;            /* SDLD_RELAX_EMIT enabled? (lazy)        */
+static a_uint *rlxDrop;                 /* abank (bank-byte addr) of each planned drop */
+static int     rlxDropN, rlxDropCap;
+
+/* sdcc88 vector-slot NOP reorder (banked-branch.md §10).  An ABSOLUTE-area
+ * banked branch (the IRQ/reset vector table) can't be byte-dropped — its slots
+ * are hardware-pinned — so a same-/common-bank target leaves the `ld nb` NOP'd
+ * at the slot HEAD: `nop nop nop ; <branch>`.  The CPU runs those 3 NOPs on
+ * every dispatch.  Reordering to `<branch> ; nop nop nop` lets an unconditional
+ * branch skip them entirely (the trailing NOPs are unreachable; on a taken
+ * conditional they fall through harmlessly).  Saves cycles, not bytes — the slot
+ * stays 6 B.  rlxReorderPend is set by the R_S1C88_BANK handler and consumed by
+ * the next reloc, the slot's word R_PCR, which rewrites the bytes once it has the
+ * resolved displacement.  Gated by SDLD_VEC_REORDER (off => byte-identical). */
+static int     rlxVecReorder = -1;      /* SDLD_VEC_REORDER enabled? (lazy)       */
+static int     rlxReorderPend;          /* this slot's R_PCR must move branch->head */
+
+/*
+ * Per-slot drop decision, indexed by R_S1C88_BANK processing order.  The order
+ * is identical in the measure sweep and the emit pass (same rel files read the
+ * same way), so the emit pass replays the measure pass's decisions by index.
+ * Filled in the measure sweep; consumed in the emit pass.
+ */
+static char   *rlxIsDrop;               /* 1 = drop this slot's 3-byte ld nb      */
+static int     rlxIsDropCap;
+int            s1c88_relax_measure;     /* set by lkmain.c around the measure sweep */
+int            rlxMeasureIdx;           /* slot counter within the measure sweep   */
+int            rlxEmitIdx;              /* slot counter within the emit pass        */
+
+static int
+rlxOn14c(void)
+{
+        if (rlx14c < 0) {
+                char *e = getenv("SDLD_RELAX");
+                rlx14c = (e != NULL && *e != '\0' && *e != '0') ? 1 : 0;
+        }
+        return rlx14c;
+}
+
+/* Stage-(i) cross-module relaxation reflow (shift + byte-drop) — sdcc88 #14c.
+ * DEFAULT ON: every link reclaims the in-range same-bank cross-module `ld nb`
+ * bytes.  Opt out with SDLD_NO_RELAX=1 for the legacy full-size layout (a debug
+ * / bisection escape hatch; the relaxed and unrelaxed builds are behaviourally
+ * identical — relaxation only removes redundant bank switches — so the unrelaxed
+ * path is the fallback if a slot is ever mis-relaxed, not a correctness crutch).
+ * The historical SDLD_RELAX_EMIT=0 still forces it off too, for back-compat with
+ * scripts written while the feature was opt-in. */
+static int
+rlxEmitOn(void)
+{
+        if (rlxEmit < 0) {
+                char *no  = getenv("SDLD_NO_RELAX");
+                char *emit = getenv("SDLD_RELAX_EMIT");
+                if (no != NULL && *no != '\0' && *no != '0')
+                        rlxEmit = 0;                    /* explicit opt-out  */
+                else if (emit != NULL && (*emit == '0' || *emit == '\0'))
+                        rlxEmit = 0;                    /* legacy SDLD_RELAX_EMIT=0 */
+                else
+                        rlxEmit = 1;                    /* default ON */
+        }
+        return rlxEmit;
+}
+
+/* sdcc88 vector-slot NOP reorder gate.  DEFAULT ON — validated by emu-test
+ * (08_isr, 12_nested_irq), diff-test, and branch-smoke.  Opt out with
+ * SDLD_NO_VECREORDER=1 (or SDLD_VEC_REORDER=0) for the legacy head-NOP layout;
+ * the two are behaviourally identical (reorder only moves dead NOPs off the
+ * dispatch path), so the legacy layout is a bisection escape hatch, not a
+ * correctness crutch.  See the rlxReorderPend comment and the R_S1C88_BANK /
+ * R3_PCR handlers below. */
+static int
+rlxVecReorderOn(void)
+{
+        if (rlxVecReorder < 0) {
+                char *no = getenv("SDLD_NO_VECREORDER");
+                char *on = getenv("SDLD_VEC_REORDER");
+                if (no != NULL && *no != '\0' && *no != '0')
+                        rlxVecReorder = 0;              /* explicit opt-out */
+                else if (on != NULL && *on == '0')
+                        rlxVecReorder = 0;              /* SDLD_VEC_REORDER=0 */
+                else
+                        rlxVecReorder = 1;              /* default ON */
+        }
+        return rlxVecReorder;
+}
+
+/* Any relaxation diagnostic/feature on ⇒ lkmain.c runs the measure sweep. */
+int
+s1c88RelaxAnyOn(void)
+{
+        return rlxOn() || rlxOn14c() || rlxEmitOn();
+}
+
+/* Record rlxIsDrop[rlxMeasureIdx]=v and advance, growing the array as needed. */
+static VOID
+rlxMarkSlot(int v)
+{
+        if (rlxMeasureIdx >= rlxIsDropCap) {
+                rlxIsDropCap = rlxIsDropCap ? rlxIsDropCap * 2 : 128;
+                rlxIsDrop = (char *) realloc(rlxIsDrop, rlxIsDropCap);
+                if (rlxIsDrop == NULL) { rlxIsDropCap = 0; return; }
+        }
+        rlxIsDrop[rlxMeasureIdx++] = (char) v;
+}
+
+/*
+ * Record a conservative stage-(i) drop candidate.  abank = address of the
+ * [bank] byte in `CE C4 [bank] <carl|jrl> <disp16>`.  The slot drops its
+ * 3-byte `ld nb` iff: same bank (else the bank switch is mandatory); the whole
+ * `ld nb` lies in THIS T-record (rtp-2 >= rtofst — else it splits across an
+ * already-emitted record); and the kept `carl` (which moves to abank-2)
+ * comfortably reaches the target (margin so a pre-shrink in-range decision
+ * still holds in the smaller post-shrink layout — monotone safety).
+ */
+static int
+rlxPlanSlot(long tgt, long abank, int tbank, int cbank, int rtp, int rtofst)
+{
+        long disp;
+
+        if (!(tbank == 0 || tbank == cbank))
+                return 0;
+        if (rtp - 2 < rtofst)
+                return 0;
+        /* Do not drop the `ld nb` of a SIGNED-cc trampoline.  The assembler
+         * precedes it with a FIXED `jrs <inv-scc>, +7` hop (CE E0+cc 07) sized
+         * to skip the whole 6-byte banked branch on the not-taken path; removing
+         * the 3-byte `ld nb` would leave that +7 overshooting the shrunk branch.
+         * The hop is a literal, not a relocation, so the linker can't fix it.
+         * The pattern is exact (always CE / E0..E7 / 07), so this never misses a
+         * real trampoline; a chance byte match merely forgoes one slot's shrink. */
+        if (rtp - 5 >= rtofst &&
+            rtval[rtp - 5] == 0xCE && (rtval[rtp - 4] & 0xF8) == 0xE0 &&
+            rtval[rtp - 3] == 0x07)
+                return 0;
+        disp = tgt - (abank - 2 + 3);           /* carl opcode @abank-2, +3 (op+disp16) */
+        if (disp < -(32768 - RLX_CARL_MARGIN) || disp > (32767 - RLX_CARL_MARGIN))
+                return 0;
+        if (rlxDropN == rlxDropCap) {
+                rlxDropCap = rlxDropCap ? rlxDropCap * 2 : 64;
+                rlxDrop = (a_uint *) realloc(rlxDrop, rlxDropCap * sizeof(a_uint));
+                if (rlxDrop == NULL) { rlxDropCap = rlxDropN = 0; return 0; }
+        }
+        rlxDrop[rlxDropN++] = (a_uint) abank;
+        return 1;
+}
+
+static int
+rlxCmpAddr(const void *a, const void *b)
+{
+        a_uint x = *(const a_uint *) a, y = *(const a_uint *) b;
+        return (x < y) ? -1 : (x > y) ? 1 : 0;
+}
+
+/* lower_bound: first index i with rlxDrop[i] >= key (rlxDrop sorted ascending). */
+static int
+rlxLowerBound(a_uint key)
+{
+        int lo = 0, hi = rlxDropN;
+        while (lo < hi) {
+                int mid = (lo + hi) / 2;
+                if (rlxDrop[mid] < key) lo = mid + 1; else hi = mid;
+        }
+        return lo;
+}
+
+/*
+ * delta(addr) = bytes removed strictly before addr WITHIN addr's code bank =
+ * 3 * (#drops d with bank(d)==bank(addr) and d < addr).  Banked code lives at
+ * (bank<<16)|logic and each 32 KB bank is a fixed physical region, so a drop in
+ * one bank must never shift addresses in another — the count is restricted to
+ * the same bank.  Each drop removes the 3 `ld nb` bytes ending at its abank; an
+ * instruction or symbol is never inside an `ld nb`, so the count is exact.
+ * rlxDrop[] is sorted ascending before this is used.
+ */
+static a_uint
+rlxDelta(a_uint addr)
+{
+        a_uint bankbase = addr & ~(a_uint) 0xFFFF;      /* (bank<<16) */
+        return (a_uint) (3 * (rlxLowerBound(addr) - rlxLowerBound(bankbase)));
+}
+
+/*
+ * sdcc88 #14e: map a pre-relax MODEL address (s_addr + a_addr, as the linker's
+ * area/symbol tables still hold it) to the address actually emitted into the ROM
+ * after #14c relaxation dropped its `ld nb` bytes.  The emit pass and the R3_SYM
+ * relocation path shift targets down by rlxDelta() but never update s_addr/a_addr,
+ * so symbol-table OUTPUTS (.map/.noi/...) would print stale, too-high addresses.
+ * Apply this to a model address at each such DISPLAY site (never to symval(),
+ * which the relocation math needs in model form).  When relaxation dropped nothing
+ * (SDLD_NO_RELAX, or a non-s1c88 link) rlxDrop[] is empty and this is the identity.
+ * Valid only after s1c88RelaxSortPlan() (lkmain.c calls it before map()).
+ */
+a_uint
+s1c88RelaxedAddr(a_uint addr)
+{
+        return addr - rlxDelta(addr);
+}
+
+/*
+ * Print the stage-(i) plan + predicted post-relax layout, and self-check the
+ * model.  Read-only: walks the area list applying delta() arithmetically; it
+ * does not touch a_addr/a_size.  Called once at end-of-link from lkmain.c.
+ */
+VOID
+s1c88RelaxPredict(void)
+{
+        struct area *ap2;
+        a_uint origrom = 0, newrom = 0;
+        int ok = 1;
+
+        if (!rlxOn14c())
+                return;
+        if (rlxDropN > 1)
+                qsort(rlxDrop, rlxDropN, sizeof(a_uint), rlxCmpAddr);
+
+        fprintf(stderr, "[relax-plan] stage-(i) conservative drops: %d slots (%d bytes)\n",
+                rlxDropN, 3 * rlxDropN);
+        if (getenv("SDLD_RELAX_DEBUG")) {
+                int di;
+                for (ap2 = areap; ap2; ap2 = ap2->a_ap)
+                        fprintf(stderr, "[relax-dbg] area %-10s base=0x%06lx size=%lu flag=0x%x\n",
+                                ap2->a_id, (unsigned long) ap2->a_addr, (unsigned long) ap2->a_size, ap2->a_flag);
+                for (di = 0; di < rlxDropN; di++)
+                        fprintf(stderr, "[relax-dbg] drop[%d] abank=0x%06lx\n", di, (unsigned long) rlxDrop[di]);
+        }
+
+        for (ap2 = areap; ap2; ap2 = ap2->a_ap) {
+                a_uint base = ap2->a_addr, size = ap2->a_size;
+                a_uint dn, nbase, nsize;
+                if (size == 0)
+                        continue;
+                dn    = rlxDelta(base + size) - rlxDelta(base);   /* dropped within area */
+                nbase = base - rlxDelta(base);
+                nsize = size - dn;
+                origrom += size;
+                newrom  += nsize;
+                if (dn > size) {                                  /* area cannot over-shrink */
+                        ok = 0;
+                        fprintf(stderr, "[relax-plan]  !! area %s: dropped %lu > size %lu\n",
+                                ap2->a_id, (unsigned long) dn, (unsigned long) size);
+                }
+                if (dn)
+                        fprintf(stderr, "[relax-plan]   %-8s 0x%06lx..+%lu  ->  0x%06lx..+%lu  (-%lu)\n",
+                                ap2->a_id, (unsigned long) base, (unsigned long) size,
+                                (unsigned long) nbase, (unsigned long) nsize, (unsigned long) dn);
+        }
+        /* every planned drop must land in exactly one area => total reclaimed == 3*N */
+        if (origrom - newrom != (a_uint) (3 * rlxDropN)) {
+                ok = 0;
+                fprintf(stderr, "[relax-plan]  !! reclaimed %lu != 3*%d (a drop fell outside all areas)\n",
+                        (unsigned long) (origrom - newrom), rlxDropN);
+        }
+        fprintf(stderr, "[relax-plan]   predicted code: %lu -> %lu bytes (%lu reclaimed)\n",
+                (unsigned long) origrom, (unsigned long) newrom, (unsigned long) (origrom - newrom));
+        fprintf(stderr, "[relax-plan]   model self-check: %s\n",
+                ok ? "OK (areas don't over-shrink; reclaim balances)" : "FAILED");
+}
+
+/*
+ * sdcc88 #14c Stage (i) emit Step 2 — finalize the shrink plan.
+ *
+ * The reflow does NOT pre-shift the linker's address structs (doing so loses the
+ * old addresses needed to compact per-record T-record positions, and mishandles
+ * boundary/length symbols).  Instead every address is delta()-adjusted at the
+ * point it is emitted in relr3 (record load address + PCR base via `pc`, and
+ * R3_SYM / R3_AREA targets).  So this routine only sorts the drop list that
+ * delta() binary-searches.  Called after the measure sweep, before emit.
+ */
+void
+s1c88RelaxSortPlan(void)
+{
+        if (rlxDropN > 1)
+                qsort(rlxDrop, rlxDropN, sizeof(a_uint), rlxCmpAddr);
+}
+
+/* True when the emit pass should delta-adjust addresses (emit on, not the
+ * measure sweep, and there is something to drop). */
+static int
+rlxAdjusting(void)
+{
+        return rlxEmitOn() && !s1c88_relax_measure && rlxDropN > 0;
+}
