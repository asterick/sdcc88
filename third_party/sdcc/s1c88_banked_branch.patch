+/* sdcc88: S1C88 banked-branch bank field (R_S1C88_BANK = 0x800).  The slot is
+ *   CE C4 [bank] [pad] <carl|jrl> <disp16>
+ * with the [bank][pad] 2-byte field at rtp..rtp+1 (the 24-bit reloc path emits
+ * a_bytes=2 placeholder bytes).  Write the target's code bank into [bank] (its
+ * linker address >> 16, code areas placed at (bank<<16)|logic) and a NOP (FF)
+ * into [pad] — yielding `ld nb,#bank ; nop ; <branch>`.  When that bank is 0
+ * (common area) or the current area's bank, NOP the whole `ld nb`+pad instead
+ * (CE C4 at rtp-2..rtp-1 plus the field) so no bank switch happens. */
+                if (mode & 0x800) {
+                        int tbank = (int) ((reli >> 16) & 0xFF);
+                        int cbank = (int) (((pc + (rtp - rtofst)) >> 16) & 0xFF);
+                        /* Leave rtflg set on these bytes so lkout() emits them. */
+                        rtval[rtp+1] = 0xFF;            /* pad -> nop */
+                        if (tbank == 0 || tbank == cbank) {
+                                rtval[rtp-2] = 0xFF;    /* nop (was CE)   */
+                                rtval[rtp-1] = 0xFF;    /* nop (was C4)   */
+                                rtval[rtp]   = 0xFF;    /* nop (was bank) */
+                        } else {
+                                rtval[rtp]   = tbank;   /* ld nb,#bank */
+                        }
+                        continue;
+                }
