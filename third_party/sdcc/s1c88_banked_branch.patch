+/* sdcc88: S1C88 banked-branch bank field (R_S1C88_BANK = 0x800).  The slot is
+ *   CE C4 [bank] <carl|jrl> <disp16>
+ * with [bank] a SINGLE in-place byte at rtp (sdas88 emits it via outr1be(), 6
+ * bytes total).  Write the target's code bank into [bank] (its linker address
+ * >> 16, code areas placed at (bank<<16)|logic) — yielding `ld nb,#bank ;
+ * <branch>`.  When that bank is 0 (common area) or the current area's bank, NOP
+ * the whole `ld nb` instead (CE C4 [bank] at rtp-2..rtp) so no bank switch
+ * happens — but ONLY when CE C4 are inside THIS T line (rtp-2 >= rtofst): the
+ * slot can split across T lines, leaving CE C4 at the end of the PREVIOUS
+ * (already emitted) record; rtp-2 would then index this record's ADDRESS bytes,
+ * corrupting its output address to 0xFFxxxx.  The fallback `ld nb,#tbank` is
+ * always semantically correct (branches copy NB->CB, and RET/RETE restore
+ * NB = CB = popped byte) — it merely keeps a redundant bank switch. */
+                if (mode & 0x800) {
+                        int tbank = (int) ((reli >> 16) & 0xFF);
+                        int cbank = (int) (((pc + (rtp - rtofst)) >> 16) & 0xFF);
+                        /* sdcc88 #14c Stage 0: read-only relaxation tally. */
+                        if (rlxOn())
+                                rlxAccount((long) reli,
+                                           (long) (pc + (rtp - rtofst)),
+                                           tbank, cbank);
+                        /* Leave rtflg set on these bytes so lkout() emits them. */
+                        if ((tbank == 0 || tbank == cbank) && rtp - 2 >= (int) rtofst) {
+                                rtval[rtp-2] = 0xFF;    /* nop (was CE)   */
+                                rtval[rtp-1] = 0xFF;    /* nop (was C4)   */
+                                rtval[rtp]   = 0xFF;    /* nop (was bank) */
+                        } else {
+                                rtval[rtp]   = tbank;   /* ld nb,#bank */
+                        }
+                        continue;
+                }
